# Copy to .env (same folder as package.json) and restart `npm run dev` after any change.

# Backend base URL (optional, this is the default)
VITE_API_URL=http://localhost:8080/api

# Google "Web application" OAuth client id (Google Cloud Console -> APIs & Services -> Credentials).
# Must be the SAME value as the backend's GOOGLE_CLIENT_ID.
# Add http://localhost:5173 to "Authorized JavaScript origins" of that client.
VITE_GOOGLE_CLIENT_ID=1069470859987-qghpt5vj0h53tp5tlejeeb099f0j64ft.apps.googleusercontent.com
